# Password Manager API Configuration
# Copy this file to .env and fill in your values

# Your Yggdrasil IPv6 address
# Get it with: yggdrasilctl getSelf
# Example: 200:1234:5678:90ab:cdef:1234:5678:90ab
YGGDRASIL_IP=

# API server port (default: 8080)
API_PORT=8080

# Auto-lock timeout in seconds (default: 300 = 5 minutes)
# Vault will automatically lock after this much inactivity
AUTO_LOCK_TIMEOUT=300

# NOTE: Master password is NO LONGER in this file!
# You will be prompted to enter it when starting the server.
# This is more secure - password never stored on disk.
